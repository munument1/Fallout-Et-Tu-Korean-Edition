.gitignore                      text eol=lf
.gitattributes                  text eol=lf
.github/actions/*/*.yml         text eol=lf
.github/workflows/*.yml         text eol=lf
.github/workflows/*.sh          text eol=lf
.github/workflows/scripts/*.sh  text eol=lf

*.diff text eol=lf
*.msg  text eol=lf
*.ssl  text eol=lf linguist-language=Pascal
*.h    text eol=lf

## Korean game data: preserve exact CP949 bytes, original line endings, whitespace
**/text/korean/** -text -diff -eol -working-tree-encoding
**/translations/korean.ini -text -diff -eol -working-tree-encoding
**/premade/*.bio -text -diff -eol -working-tree-encoding
**/PREMADE/*.bio -text -diff -eol -working-tree-encoding
